# ==========================================
# NOVERAILE PUBLISHING - ENVIRONMENT CONFIG
# ==========================================

# Database
# Local SQLite default (out-of-the-box):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/noveraile?schema=public"

# Application URLs & Branding
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Noveraile Publishing"
NEXT_PUBLIC_SITE_DOMAIN="noverailepublishing.com"
NEXT_PUBLIC_SITE_TAGLINE="Books built for where you're going next."
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_CONTACT_EMAIL="support@noverailepublishing.com"

# Security & Sessions
JWT_SECRET="noveraile_super_secret_jwt_key_development_32chars_minimum"
SESSION_EXPIRY_DAYS=30

# Stripe Payments (Leave empty to use automatic Sandbox Checkout mode for instant testing)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Storage Configuration
# "local" saves to private local directory; "r2" or "s3" for cloud object storage
STORAGE_DRIVER="local"
PRIVATE_STORAGE_PATH="./storage/private"

# AWS / Cloudflare R2 / S3 Configuration (Optional for cloud storage)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_BUCKET_NAME="noveraile-private-books"
S3_ENDPOINT=""

# Transactional Email (Optional, Resend or SMTP)
RESEND_API_KEY=""
EMAIL_FROM="Noveraile Publishing <orders@noverailepublishing.com>"
