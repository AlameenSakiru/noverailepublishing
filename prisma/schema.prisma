// Prisma Schema for Noveraile Publishing Platform
// Dual-compatible: Runs on SQLite out-of-the-box locally, easily switchable to PostgreSQL in production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             String            @default("CUSTOMER") // "CUSTOMER", "EDITOR", "ADMIN"
  avatarUrl        String?
  isEmailVerified  Boolean           @default(false)
  status           String            @default("ACTIVE")   // "ACTIVE", "SUSPENDED"
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  sessions         Session[]
  orders           Order[]
  entitlements     Entitlement[]
  readingProgress  ReadingProgress[]
  bookmarks        Bookmark[]
  reviews          Review[]
  couponUses       CouponUse[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  userAgent   String?
  ipAddress   String?
  lastActive  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  heroImage   String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  books       Book[]

  @@index([slug])
  @@index([parentId])
}

model Author {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  bio          String
  profileImage String?
  website      String?
  twitter      String?
  linkedin     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  books        Book[]

  @@index([slug])
}

model Imprint {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  websitePath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books       Book[]

  @@index([slug])
}

model Book {
  id                 String             @id @default(cuid())
  title              String
  subtitle           String?
  slug               String             @unique
  isbn               String?
  edition            String             @default("1st Edition")
  language           String             @default("English")
  pageCount          Int                @default(0)
  coverImage         String
  description        String
  shortDescription   String
  keyBenefits        String?            // JSON string array of key takeaways
  whoIsThisFor       String?            // JSON string array of target readers
  tableOfContents    String?            // JSON array of chapter titles and starting pages
  specifications     String?            // JSON object of specs
  faq                String?            // JSON array of {q, a}
  price              Float              @default(29.99)
  salePrice          Float?
  currency           String             @default("USD")
  status             String             @default("PUBLISHED") // "DRAFT", "PUBLISHED", "ARCHIVED", "SCHEDULED"
  isFeatured         Boolean            @default(false)
  isBestseller       Boolean            @default(false)
  isComingSoon       Boolean            @default(false)
  previewPageNumbers String             @default("[1,2,3]")   // JSON array of previewable page numbers
  
  seoTitle           String?
  seoDesc            String?
  seoKeywords        String?

  categoryId         String
  authorId           String
  imprintId          String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  category           Category           @relation(fields: [categoryId], references: [id])
  author             Author             @relation(fields: [authorId], references: [id])
  imprint            Imprint?           @relation(fields: [imprintId], references: [id], onDelete: SetNull)
  
  examMetadata       ExamMetadata?
  pageAssets         BookPageAsset[]
  orderItems         OrderItem[]
  entitlements       Entitlement[]
  readingProgress    ReadingProgress[]
  bookmarks          Bookmark[]
  reviews            Review[]

  @@index([slug])
  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([isFeatured])
  @@index([isBestseller])
}

model ExamMetadata {
  id            String  @id @default(cuid())
  bookId        String  @unique
  examName      String
  examAcronym   String  // e.g. "PTCB", "NCLEX-RN", "Security+", "PMP"
  examAuthority String  // e.g. "Pharmacy Technician Certification Board"
  profession    String  // e.g. "Pharmacy / Healthcare"
  yearVersion   String  @default("2027")
  disclaimer    String  @default("Noveraile Publishing is an independent publisher and is not affiliated with or endorsed by official certification bodies unless explicitly stated otherwise.")

  book          Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([examAcronym])
}

model BookPageAsset {
  id           String   @id @default(cuid())
  bookId       String
  pageNumber   Int
  title        String?
  chapterTitle String?
  contentHtml  String   // Formatted rich text/HTML with typography, figures, questions
  wordCount    Int      @default(0)
  createdAt    DateTime @default(now())

  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, pageNumber])
  @@index([bookId, pageNumber])
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique // e.g. "NOV-2026-98124"
  userId                String?
  customerEmail         String
  totalAmount           Float
  subtotal              Float
  discountAmount        Float         @default(0.0)
  currency              String        @default("USD")
  paymentStatus         String        @default("PENDING") // "PENDING", "PAID", "FAILED", "REFUNDED"
  stripeSessionId       String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  payment               Payment?
  refundRecord          RefundRecord?
  entitlements          Entitlement[]
  couponUses            CouponUse[]

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([paymentStatus])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  bookId     String
  price      Float
  bookTitle  String

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId], references: [id])

  @@index([orderId])
  @@index([bookId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  provider      String   @default("STRIPE") // "STRIPE", "SANDBOX"
  transactionId String
  status        String   // "SUCCEEDED", "FAILED", "PENDING"
  amount        Float
  currency      String   @default("USD")
  receiptUrl    String?
  createdAt     DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Entitlement {
  id               String    @id @default(cuid())
  userId           String
  bookId           String
  orderId          String?
  status           String    @default("ACTIVE") // "ACTIVE", "REVOKED", "EXPIRED"
  grantedAt        DateTime  @default(now())
  revokedAt        DateTime?
  revocationReason String?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book             Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model ReadingProgress {
  id              String   @id @default(cuid())
  userId          String
  bookId          String
  currentPage     Int      @default(1)
  totalPages      Int      @default(1)
  progressPercent Float    @default(0.0)
  lastReadAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  bookId     String
  pageNumber Int
  label      String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
}

model Review {
  id                 String   @id @default(cuid())
  bookId             String
  userId             String
  rating             Int      @default(5) // 1 to 5
  title              String
  comment            String
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())

  book               Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
}

model Coupon {
  id             String      @id @default(cuid())
  code           String      @unique
  discountType   String      @default("PERCENTAGE") // "PERCENTAGE", "FIXED"
  discountValue  Float
  minOrderAmount Float       @default(0.0)
  maxUses        Int         @default(1000)
  usedCount      Int         @default(0)
  startDate      DateTime    @default(now())
  endDate        DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  uses           CouponUse[]

  @@index([code])
}

model CouponUse {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  usedAt    DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model RefundRecord {
  id          String   @id @default(cuid())
  orderId     String   @unique
  amount      Float
  reason      String
  processedAt DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  source      String   @default("homepage_footer")
  consentDate DateTime @default(now())
  isActive    Boolean  @default(true)

  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g. "BOOK_CREATED", "REFUND_PROCESSED", "ENTITLEMENT_REVOKED"
  entityType String   // e.g. "Book", "Order", "User"
  entityId   String?
  details    String?  // JSON formatted details
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
}
