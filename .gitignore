# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
/build

# Environment files
.env
.env*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# SQLite runtime locks & journals (prevent git corruption)
*.db-journal
*.db-shm
*.db-wal

# OS files
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# Uploaded temporary scratch files
storage/private/temp/*
!storage/private/manuscripts/
